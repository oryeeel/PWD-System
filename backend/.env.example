MONGODB_URI=your_mongodb_connection_string
IPROG_API_TOKEN=
# Required when NODE_ENV=production or SERVER_AUTH=true.
SERVER_AUTH=false
SESSION_SECRET=
# Generate a private random value of at least 32 bytes; never commit the real key.
AUDIT_LOG_HMAC_KEY=
APP_ORIGIN=
SESSION_COOKIE_SAME_SITE=lax
# Used only to create the first admin; remove ADMIN_PASSWORD after setup.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_EMAIL=
# SMTP settings enable email password recovery and Admin sign-in verification.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
